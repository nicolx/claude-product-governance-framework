{
  "permissions": {
    "allow": [
      "Bash(bash .claude/hooks/governance-sync.sh:*)",
      "Bash(bash .claude/hooks/governance-dump.sh:*)",
      "Bash(bash .claude/hooks/check-connectors.sh:*)",
      "Bash(bash .claude/hooks/check-pending-approvals.sh:*)",
      "Bash(bash .claude/hooks/check-inbox.sh:*)",
      "Bash(bash .claude/hooks/check-unpushed.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git fetch:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/governance-sync.sh\" pull",
            "timeout": 25,
            "statusMessage": "Sincronizzo l'istanza da origin (pull)…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-pending-approvals.sh\"",
            "timeout": 10,
            "statusMessage": "Verifica coda di approvazione…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-connectors.sh\"",
            "timeout": 10,
            "statusMessage": "Verifica connettori esterni dichiarati…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-unpushed.sh\"",
            "timeout": 10,
            "statusMessage": "Verifica modifiche non pushate…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-inbox.sh\"",
            "timeout": 10,
            "statusMessage": "Verifica product/inbox/ non processata…"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-pending-approvals.sh\"",
            "timeout": 10,
            "statusMessage": "Verifica coda di approvazione…"
          }
        ]
      }
    ]
  }
}
