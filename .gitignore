# product/inbox/ è il raccoglitore universale del materiale grezzo non
# ancora triagiato (email, thread, trascrizioni, allegati, immagini, di
# dimensione imprevedibile). Non va mai committato: la skill inbox-triage
# lo svuota spostando ogni elemento nel posto corretto (product/ideas/,
# product/prds/, ecc.) non appena lo classifica.
product/inbox/*
!product/inbox/.gitkeep

# product/demos/captures/<idea-slug>/screenshots/ contiene gli screenshot
# dimostrativi generati da demo-capture: artefatti binari, non vanno in
# Git. Il manifest.yaml accanto (record di audit: cosa/quale commit/quando)
# resta invece tracciato.
product/demos/captures/*/screenshots/

# Artefatti locali comuni
.DS_Store
